{
  "name": "ucare-backend",
  "version": "1.0.0",
  "description": "Backend API service for Unicare smart lab maintenance system",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch \"src/**/*\" --ext \"ts,json\" --exec \"ts-node src/server.ts\"",
    "build": "tsc",
    "test": "jest --runInBand --detectOpenHandles --forceExit=false",
    "seed": "ts-node scripts/seedUsers.ts",
    "seed:students": "ts-node scripts/seedStudents.ts"
  },
  "keywords": [
    "express",
    "ucare",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
